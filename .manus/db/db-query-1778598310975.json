  "query": "\nSELECT r.id as resident_id, r.firstName, r.lastName, r.email, \n       p.id as pkg_id, p.isActive, p.totalHours, p.usedHours, \n       (p.totalHours - p.usedHours) as remaining, p.endDate, p.startDate\nFROM residents r\nJOIN packages p ON p.residentId = r.id\nWHERE r.isActive = 1 AND r.isDeleted = 0\n  AND r.email IS NOT NULL AND r.email != ''\nORDER BY r.id, p.id DESC;\n",
