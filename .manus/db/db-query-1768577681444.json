  "query": "\nSELECT \n  p.id, \n  p.residentId, \n  r.firstName, \n  r.lastName, \n  p.expirationEmailSent,\n  p.endDate,\n  p.totalHours,\n  p.usedHours,\n  (SELECT MAX(p2.id) FROM packages p2 WHERE p2.residentId = p.residentId) as maxId\nFROM packages p\nLEFT JOIN residents r ON p.residentId = r.id\nWHERE (p.endDate < NOW() OR p.totalHours - p.usedHours <= 0)\nORDER BY p.residentId, p.id DESC;\n",
