# =============================================================================
# gestion-atelier — variables d'environnement (exemple, sans valeurs)
# Copier en .env et renseigner. Le .env n'est PAS versionné.
# =============================================================================

# --- Général ---
NODE_ENV=production
# Port d'écoute du serveur (défaut: 3000)
PORT=3000

# --- Base de données (Phase 5 : nouvelle base MySQL/TiDB) ---
# Format: mysql://utilisateur:motdepasse@hote:port/base
DATABASE_URL=

# --- Session ---
# Secret de signature du cookie de session (JWT HS256). Générer une valeur
# robuste, ex: openssl rand -base64 48
JWT_SECRET=

# --- URL publique du site (IMPORTANT) ---
# Utilisée pour construire les liens dans les e-mails (guide, rappels, correction
# de pointage). Si absente, un ancien domaine Manus mort est utilisé par défaut :
# les liens des e-mails seraient cassés SANS ERREUR VISIBLE. À définir absolument.
PUBLIC_SITE_URL=

# --- E-mails (SMTP Gmail — host/port codés en dur: smtp.gmail.com:587) ---
# Pour Gmail, utiliser un "mot de passe d'application" (pas le mot de passe du compte).
EMAIL_USER=
EMAIL_PASSWORD=

# --- Cron (endpoints /api/cron protégés par clé) ---
# Clé suffisamment longue (> 20 caractères).
CRON_API_KEY=

# --- Optionnel ---
# Niveau de log pino (ex: info, debug, warn)
LOG_LEVEL=info
# Personnalisation client (build Vite)
VITE_APP_TITLE=
VITE_APP_LOGO=

# =============================================================================
# OBSOLÈTES — ne plus définir (spécifiques Manus, supprimés lors de la migration)
#   OAUTH_SERVER_URL, OWNER_OPEN_ID, VITE_APP_ID, VITE_OAUTH_PORTAL_URL
#   BUILT_IN_FORGE_API_URL, BUILT_IN_FORGE_API_KEY
# =============================================================================
